# Copy to .env (gitignored) and adjust as needed. Neither variable is
# required for normal operation -- see config/settings.py::SatelliteConfig
# and services/satellite.py for details.

# Set to "false" to skip live Landsat acquisition entirely and use the local
# raster file / mock thermal data instead (useful offline or in CI).
USE_REMOTE_SATELLITE_DATA=true

# Optional. Raises Microsoft Planetary Computer's anonymous rate limit for
# the STAC API. Get one at https://planetarycomputer.microsoft.com/account/request
# Never required for the request volume a hackathon/prototype demo generates.
PC_SDK_SUBSCRIPTION_KEY=
